;;; This code will:
;;; 1. Create a new smart contract using burner.evm
;;; 2. Call the new smart contract

;; burner.evm, assembled
PUSH10 0x6130ff5f526002601ef3 ; value
PUSH0 ; offset
MSTORE

;; Preload stack for CALL
PUSH0 ; retSize
PUSH0 ; retOffset
PUSH0 ; argsSize
PUSH0 ; argsOffset
PUSH0 ; value

  ;; address for CALL
  PUSH1 10 ; size
  PUSH1 22 ; offset
  CALLVALUE ; value
  CREATE

GAS ; gas
CALL

;;; This smart contract, assembled:
;;; 0x696130ff5f526002601ef35f525f5f5f5f5f600a601634f05af1
